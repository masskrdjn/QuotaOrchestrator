{
  "name": "quota-orchestrator",
  "description": "Selective multi-model routing for Codex and Claude Code, with specialized agents, skills, and trusted hooks.",
  "author": {
    "name": "masskrdjn",
    "url": "https://github.com/masskrdjn"
  },
  "version": "0.10.1",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": [
    "claude-code",
    "routing",
    "subagents",
    "cost-optimization"
  ],
  "skills": "./claude/.claude/skills/",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task|TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/claude/.claude/hooks/agent_identity.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/claude/CLAUDE.md\""
          }
        ]
      }
    ]
  }
}
